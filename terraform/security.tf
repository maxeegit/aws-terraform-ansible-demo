resource "aws_security_group" "web" {
  name        = "${var.project_name}-sg"
  description = "Security group for Terraform and Ansible demo web server"
  vpc_id      = aws_vpc.main.id

  # Allow HTTP traffic to the web application
  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # Allow all outbound traffic
  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name    = "${var.project_name}-sg"
    Project = var.project_name
  }
}
